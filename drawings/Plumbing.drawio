        <mxCell id="R_E__AGXzr3JBp12_yaD-92" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="110.95" width="93.98" x="388.97" y="80" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-113" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=31;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255)); font-size: 12px; text-align: left; background-color: transparent;&quot;&gt;Most propane powered water heaters will work but some important notes:&amp;nbsp;&lt;/span&gt;&lt;ol style=&quot;font-size: 12px; text-align: left;&quot;&gt;&lt;li&gt;&amp;nbsp;Will heat the water too hot during the day - can&#39;t be turned low enogh&lt;/li&gt;&lt;li&gt;You must drain the water before storage in cold climates&lt;/li&gt;&lt;li&gt;Takes 2 D batteries - keep spares&lt;/li&gt;&lt;li&gt;Exhaust must be vented and covered to keep dust from getting in&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="227.07" width="340" x="42.460000000000036" y="182.93" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-114" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=18;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="One 25lb tank seems to be enough for a week&lt;div&gt;&lt;br style=&quot;font-size: 12px;&quot;&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="91" width="198.89" x="382.46" y="760" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-115" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=12;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="The only way to provide consistent water temperatures is to use a mixer valve&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="180" x="812.6" y="50" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-116" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=17;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="Flowmeter should be calibrated since they are never close to accurate" vertex="1">
          <mxGeometry height="70" width="220.85" x="1239.15" y="310" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-117" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=14;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="Hose to shower faucet handle passes through the heater/electronic box - make sure it&#39;s long enough to reach to shower area and be high enough" vertex="1">
          <mxGeometry height="77" width="288.97" x="1220" y="580" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-118" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=17;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="valves to cold and hot sides can be used to fine tune mixing and provide water flow control" vertex="1">
          <mxGeometry height="91" width="241.72" x="807.29" y="860" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-120" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=17;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;SeaFlo have been reliable but many others available - Look for 3 gpm pumps that can self prime with 10 to 12 feet pull. PSI not too important&lt;/span&gt;" vertex="1">
          <mxGeometry height="151.26" width="141.17" x="758.8299999999999" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-121" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=14;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="On upstream of pump you want a hose that has stiff enough walls it won&#39;t collapse under vacuum. I use a hose with wire reinforcement or with embedded cloth braiding.&amp;nbsp; Food grade best for people, but not required for showers" vertex="1">
          <mxGeometry height="140.47" width="230" x="1430" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-122" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=18;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="Placement of the pump should be low as possible since it will have an easier time self priming." vertex="1">
          <mxGeometry height="150" width="150" x="577.4" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-123" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=15;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="Most of the fittings are 1/2 NPT on the pump and accumulator, which works out to 1/2 FPT for the faucet hoses you see here." vertex="1">
          <mxGeometry height="150" width="150" x="560.08" y="890" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-124" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=16;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="The accumulator evens out the pulses, and you can adjust the pressure like you would a bike tire - has the same valve" vertex="1">
          <mxGeometry height="150" width="150" x="950" y="1140" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-125" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=21;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="Your manifold maybe different" vertex="1">
          <mxGeometry height="110.95" width="110" x="1150" y="1640" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-126" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=17;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="Flexible hose from supply tank to manifold" vertex="1">
          <mxGeometry height="110.95" width="92.6" x="1294" y="2063.98" as="geometry" />
        </mxCell>
        <mxCell id="R_E__AGXzr3JBp12_yaD-127" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;autosizeText=1;fontColor=#000000;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fillStyle=solid;fontSize=15;direction=west;gradientDirection=north;gradientColor=#FFF2A1;shadow=1;size=20;pointerEvents=1;" value="&lt;span style=&quot;font-size: 12px;&quot;&gt;This pipe passes through the enclosure from outside - usually about 3in or less 1/2 NPT&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="130.49" x="313.48" y="1700" as="geometry" />
        </mxCell>
